# Exa API Integration Examples — environment template
# Copy to .env and fill in your own keys. Never commit a real .env.

# Required for all examples
EXA_API_KEY=your_exa_api_key_here

# Optional — only needed for the respective function-calling examples
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
